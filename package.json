{
  "name": "fiberapp",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build --configuration production --base-href /fiberapp/",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:pages": "ng build --configuration production --base-href /fiberapp/ && node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
