{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "fiberapp": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ff",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/fiberapp",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ],
            "assets": [
              {
                "glob": "map.html",
                "input": "planner",
                "output": "/planner"
              },
              {
                "glob": "project-map.css",
                "input": "planner",
                "output": "/planner"
              },
              {
                "glob": "project-map.js",
                "input": "planner",
                "output": "/planner"
              },
              {
                "glob": "**/*",
                "input": "src/components/modals/searchaddressunits-modal",
                "output": "/src/components/modals/searchaddressunits-modal"
              },
              {
                "glob": "**/*",
                "input": "src/components/maptools",
                "output": "/src/components/maptools"
              }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kb",
                  "maximumError": "2mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "fiberapp:build:development"
          }
        }
      }
    }
  }
}
